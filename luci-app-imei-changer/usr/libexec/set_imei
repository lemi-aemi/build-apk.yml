#!/bin/sh

ACTION=$1
MODEM_TYPE=$2
PORT=$3
IMEI=$4
CUSTOM_CMD=$5 # Parameter ke-5 untuk AT Command / Nama File Backup

if [ "$ACTION" != "list_backups" ] && [ "$ACTION" != "load_backup" ] && [ ! -e "$PORT" ]; then
    echo "[Error] Port $PORT tidak ditemukan!"
    exit 1
fi

send_at() {
    stty -F "$PORT" 115200 raw -echo -echoe -echok 2>/dev/null
    if [ -f "/usr/bin/atinout" ]; then
        echo "$1" | atinout - "$PORT" -
    else
        echo -e "$1\r" > "$PORT" &
        sleep 1
        kill $! 2>/dev/null
    fi
}

case "$ACTION" in
    "check")
        echo "[Info] Mengecek status pada $PORT..."
        [ "$MODEM_TYPE" = "dell" ] && send_at "AT^NV=550" || send_at "ATI;+CGSN"
        ;;
    "update")
        [ -z "$IMEI" ] && echo "[Error] IMEI kosong!" && exit 1
        if [ "$MODEM_TYPE" = "dell" ]; then
            send_at "AT^NV=550,9,\"$IMEI\""
        else
            send_at "AT+EGMR=1,7,\"$IMEI\""
        fi
        echo "[Info] Selesai. Gunakan AT Send: AT+CFUN=1,1 jika perlu restart modem."
        ;;
    "custom")
        if [ -n "$CUSTOM_CMD" ]; then
            echo "[Action] Mengirim perintah manual: $CUSTOM_CMD"
            send_at "$CUSTOM_CMD"
        else
            echo "[Error] Perintah AT kosong!"
        fi
        ;;
    "cfun")
        echo "[Action] Mengirim perintah restart modem: AT+CFUN=1,1 pada $PORT"
        send_at "AT+CFUN=1,1"
        ;;
    "backup")
        echo "[Action] Mengambil Backup IMEI dari modem $PORT..."
        if [ "$MODEM_TYPE" = "dell" ]; then
            IMEI_OUT=$(send_at "AT^NV=550")
        else
            IMEI_OUT=$(send_at "AT+CGSN")
        fi
        
        DETECTED_IMEI=$(echo "$IMEI_OUT" | grep -oE '[0-9]{15}' | head -n 1)
        if [ -n "$DETECTED_IMEI" ]; then
            mkdir -p /etc/config/imei_backups
            # Menyimpan file dengan nama Nomor IMEI.txt
            echo "$DETECTED_IMEI" > "/etc/config/imei_backups/${DETECTED_IMEI}.txt"
            echo "[OK] IMEI Terdeteksi: $DETECTED_IMEI"
            echo "[OK] Berhasil disimpan di: /etc/config/imei_backups/${DETECTED_IMEI}.txt"
        else
            echo "[Error] Gagal membaca IMEI dari output modem:"
            echo "$IMEI_OUT"
        fi
        ;;
    "list_backups")
        mkdir -p /etc/config/imei_backups
        ls -1 /etc/config/imei_backups/*.txt 2>/dev/null
        ;;
    "load_backup")
        FILE_PATH="/etc/config/imei_backups/$CUSTOM_CMD"
        if [ -f "$FILE_PATH" ]; then
            cat "$FILE_PATH" | grep -oE '[0-9]{15}' | head -n 1
        else
            echo "[Error] File backup tidak ditemukan!"
        fi
        ;;
    *)
        echo "Usage: $0 {check|update|custom|cfun|backup|list_backups|load_backup} {type} {port} [imei/cmd]"
        ;;
esac
