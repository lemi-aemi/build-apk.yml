{
	"luci-app-imei-changer": {
		"description": "Grant access to IMEI Changer scripts",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/config/imei_changer": [ "read" ],
				"/usr/bin/set_imei": [ "read" ]
			},
			"uci": [ "imei_changer" ]
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/config/imei_changer": [ "write" ]
			},
			"uci": [ "imei_changer" ]
		}
	}
}
